KOFI_VERIFICATION_TOKEN=tu_token_de_ko-fi
KO_FI_WEBHOOK_PORT=8080
DISCORD_GUILD_ID=0
DISCORD_BOT_TOKEN=tu_token_del_bot_de_discord
DISCORD_APPLICATION_ID=0
# Monetizar → User subscription "Socio VCT" (type 5 SUBSCRIPTION, no type 6 ni guild).
# ID en portal Discord: Monetizar → Gestionar SKU.
DISCORD_SKU_SOCIO_VCT_ID=0
PANEL_PASSWORD=tu_contraseña_privada_del_panel

# Patreon (opcional) — publicar_vct.ps1 crea un post al publicar actualizaciones
# Token: Patreon → Developer / Creator API (scope: posts, campaigns)
PATREON_ACCESS_TOKEN=
PATREON_CAMPAIGN_ID=
# Opcional: solo si el access token caduca (Creator refresh token del portal)
PATREON_REFRESH_TOKEN=

# Gmail (opcional) — enviar_backup_gmail.py
# Usa contraseña de aplicación de Google, no la contraseña de la cuenta.
GMAIL_USER=tu_correo@gmail.com
GMAIL_DEST=tu_correo@gmail.com
GMAIL_APP_PASSWORD=
